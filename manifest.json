{
	"name": "Xdebug Helper",
	"description": "Xdebug调试助手 - 轻松启用/禁用PHP代码的调试、分析和跟踪功能，支持Xdebug 2.x和3.x",
	"version": "3.0.0",
	"author": "tekintian",
	"manifest_version": 3,
	"minimum_chrome_version": "88",
	"permissions": [ "tabs", "storage" ],
	"host_permissions": [ "*://*/*" ],
	"icons": {
		"16": "images/icon--16.png",
		"48": "images/icon--48.png",
		"128": "images/icon--128.png",
		"256": "images/icon--256.png",
		"512": "images/icon--256.png"
	},

	"options_page": "options.html",

	"action": {
		"default_icon": "images/bug-gray.png",
		"default_title": "Debugging, profiling & tracing disabled",
		"default_popup" : "popup.html"
	},
	"content_scripts": [ {
		"js": [ "content.js" ],
		"matches": [ "*://*/*" ]
	} ],
	"background": {
		"service_worker": "background.js"
	},

	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Ctrl+Shift+X",
				"windows": "Ctrl+Shift+X",
				"mac": "Command+Shift+X"
			},
			"description": "Open popup to toggle state"
		},
		"toggle_debug_action": {
			"suggested_key": {
				"default": "Alt+Shift+X",
				"windows": "Alt+Shift+X",
				"mac": "Alt+Shift+X"
			},
			"description": "Toggle between the debug states"
		}
	}
}
